# Metom production router
# Public URLs stay clean while static files live in /public_html/metom-static/

Options -Indexes
RewriteEngine On

# Permanent redirects from the old journal URLs to the final blog structure.
RewriteRule ^jurnal/?$ /blog/ [R=301,L]
RewriteRule ^jurnal/(.+?)/?$ /blog/$1/ [R=301,L,NE]

# Keep cPanel/system paths out of the static router.
RewriteRule ^cgi-bin(?:/|$) - [L]

# WordPress staging is not intended to be public while production is static.
# Return 403 instead of exposing a second attack surface.
RewriteRule ^staging(?:/|$) - [F,L]

# Block hidden/sensitive files (except ACME /.well-known/ challenges) and common backups.
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
RewriteRule \.(?:bak|conf|config|dist|env|ini|log|sql|sqlite|tar|tgz|gz|zip)$ - [F,L,NC]

# Prevent /metom-static/ from becoming a second public URL for the same content.
# Internal rewrites do not match THE_REQUEST, so they continue to work.
RewriteCond %{THE_REQUEST} \s/+metom-static(?:[/?\s]) [NC]
RewriteRule ^metom-static(?:/(.*))?$ /$1 [R=301,L,NE]

# Homepage must always use the deployed Metom static site.
# This must run before the real-directory bypass because / maps to public_html itself.
RewriteRule ^$ metom-static/index.html [L]

# Legacy relative asset fallback for clean URLs, e.g. /kitchen-set-malang/assets/detail.css
RewriteCond %{DOCUMENT_ROOT}/metom-static/assets/$1 -f
RewriteRule ^.+/assets/(.+)$ metom-static/assets/$1 [L]

# Keep real files/directories that belong to public_html working normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Static assets/files with explicit extensions.
RewriteCond %{DOCUMENT_ROOT}/metom-static/$1 -f
RewriteRule ^(.+)$ metom-static/$1 [L]

# Clean nested routes, e.g. /proyek/al-izzah/
RewriteCond %{DOCUMENT_ROOT}/metom-static/$1/index.html -f
RewriteRule ^(.+?)/?$ metom-static/$1/index.html [L]

# Clean flat routes, e.g. /kitchen-set-malang/
RewriteCond %{DOCUMENT_ROOT}/metom-static/$1.html -f
RewriteRule ^(.+?)/?$ metom-static/$1.html [L]

# Custom 404.
ErrorDocument 404 /404.html

# Security headers.
ServerSignature Off
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://script.google.com https://script.googleusercontent.com; form-action 'self' https://api.whatsapp.com https://wa.me; upgrade-insecure-requests"
</IfModule>
